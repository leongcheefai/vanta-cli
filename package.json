{
  "name": "vanta-cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "vanta": "./dist/index.js"
  },
  "files": ["dist", "scripts"],
  "scripts": {
    "build": "tsup",
    "postinstall": "cd \"$HOME\" && node \"${npm_config_prefix}/lib/node_modules/vanta-cli/scripts/postinstall.js\" 2>/dev/null || true",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^12.0.0",
    "execa": "^9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
